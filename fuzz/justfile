# Fuzz workspace automation (independent of the main workspace).
#
# Hand-written seeds live in seeds/<target>/ (committed); the runtime-grown
# corpus lands in corpus/<target>/ (gitignored at the repo root, local state
# only).

fmt:
    cargo fmt --all

lint:
    RUSTFLAGS="${RUSTFLAGS:-} --cfg fuzzing" cargo +nightly clippy --workspace --all-targets -- -D warnings

# CI gate: formatting check + clippy, fails fast before fuzzing. The committed
# seeds are checked too: a seed whose outcome no longer matches what it was
# added for is a corpus bug, not a fuzzing result.
ci-check:
    cargo fmt --all -- --check
    RUSTFLAGS="${RUSTFLAGS:-} --cfg fuzzing" cargo +nightly clippy --workspace --all-targets -- -D warnings
    just check-seeds

# Check the committed multipart_parser seeds against the outcome each one is
# committed for (see bin/check_seeds.rs), so the corpus cannot rot silently.
check-seeds:
    cargo +nightly run --quiet --bin check_seeds -- seeds/multipart_parser

# Run a fuzz target (requires cargo-fuzz; uses nightly + ASan).
#
# ARGS are passed to cargo-fuzz verbatim, so pass libFuzzer flags after `--`,
# and include `-timeout=25`: a target that hangs is then reported as an artifact
# instead of a stuck run. `ci-run` always passes it.
fuzz name *ARGS:
    #!/bin/bash -e
    mkdir -p "corpus/{{name}}"
    if [ -d "seeds/{{name}}" ]; then
        cp -n seeds/{{name}}/* "corpus/{{name}}/" || true
    fi
    exec cargo +nightly fuzz run {{name}} {{ARGS}}

# Regenerate committed seeds for xml_bodies (validates every seed: parse,
# serialize, roundtrip idempotence). Pass --features minio for the second
# codegen variant.
gen-corpus *ARGS:
    cargo +nightly run --release --bin gen_corpus -- seeds/xml_bodies {{ARGS}}

# CI entry: compact the accumulated corpus (keep only coverage-increasing
# inputs), re-seed, then fuzz for the full time budget. FEATURES is the
# optional cargo-fuzz feature flag (e.g. "--features minio"). The per-input
# timeout turns a hang into an artifact the job can upload.
ci-run target FEATURES="" BUDGET="1800":
    #!/bin/bash -e
    mkdir -p "corpus/{{target}}" "merged/{{target}}"
    if [ -d "seeds/{{target}}" ]; then
        cp -n seeds/{{target}}/* "corpus/{{target}}/" || true
    fi
    cargo +nightly fuzz run {{target}} {{FEATURES}} --target x86_64-unknown-linux-gnu -- "merged/{{target}}" "corpus/{{target}}" -merge=1 -close_fd_mask=3 || true
    if [ -n "$(ls -A "merged/{{target}}" 2>/dev/null)" ]; then
        rm -rf "corpus/{{target}}"
        mv "merged/{{target}}" "corpus/{{target}}"
    fi
    cargo +nightly fuzz run {{target}} {{FEATURES}} --target x86_64-unknown-linux-gnu -- -max_total_time={{BUDGET}} -timeout=25 -print_final_stats=1
