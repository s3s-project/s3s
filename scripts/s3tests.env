# ceph/s3-tests revision used by the `local` fallback of scripts/e2e-s3tests.sh.
# The default path runs the pinned image below instead, whose source revision is
# recorded in the fork's .s3tests-source-ref (5522d1c3...).
S3TESTS_REF="${S3TESTS_REF:-fb8b73092bb1dd8db829f1205a9e52e73bf9a232}"

# The suite runs from an image s3s controls: s3s-project/s3-tests builds the pinned
# upstream revision with the fixture patches in patches/ applied on top and freezes
# its dependencies into requirements.lock.txt, so one tag identifies one exact suite.
# Pin the tag and the digest. Set S3TESTS_IMAGE_REF=local to use the git clone + venv
# fallback above (for developing against an unpushed suite revision).
S3TESTS_IMAGE_REF="${S3TESTS_IMAGE_REF:-ghcr.io/s3s-project/s3-tests:202610071400@sha256:a63684b48157d5bbe785a01c8b2783793673a4982103fc75c604dbd03ee7703e}"
