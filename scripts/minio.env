# MinIO stopped publishing free Docker images in October 2025 and removed the
# `minio/minio` repository from Docker Hub in September 2026. s3s therefore
# builds the last upstream state from source and publishes it to
# ghcr.io/s3s-project/minio (see the `s3s` branch of s3s-project/minio); that
# build also carries the GHSA-jjjj-jwhf-8rgr fix, which the last published
# image predates. Override `MINIO_IMAGE_REF` to test another build.
MINIO_IMAGE_REF="${MINIO_IMAGE_REF:-ghcr.io/s3s-project/minio:202609131324@sha256:d75ad1da839acdc07e325004fea78afb9e757548c5ec2ae8ababa7e0ff7937c7}"
