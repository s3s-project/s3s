# Keep the client used by local runs and CI reproducible. Override both values
# together when intentionally testing another rclone release.
RCLONE_IMAGE_REF="${RCLONE_IMAGE_REF:-rclone/rclone:1.75.0@sha256:b06aed988cf5967de7c25be5925240983981c757f4ed1ac9d2fa659d51d60548}"
RCLONE_VERSION_LINE="${RCLONE_VERSION_LINE:-rclone v1.75.0}"
